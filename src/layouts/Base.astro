---
import '../styles/global.css'
import Authors from "@components/Authors.astro";
import Footer from "@components/Footer.astro";
import Header from "@components/Header.astro";
import TagCloud from "@components/TagCloud.astro";
import Tracking from "@components/Tracking.astro";
// import OffCanvas from "@components/OffCanvas.astro";
import { ClientRouter } from "astro:transitions";

// Supports weights 100-900
// import "@fontsource-variable/montserrat";
// Supports weights 300-900
// import "@fontsource-variable/rubik";
// Supports weights 100-800
// import "@fontsource-variable/jetbrains-mono";
// Supports weights 100-900
// import '@fontsource-variable/work-sans';
// Supports weights 100-900
// import '@fontsource-variable/outfit';
// Supports weights 200-900
// import '@fontsource-variable/nunito-sans';
// import '@fontsource-variable/cairo';
interface Props {
  title: string;
  seotitle?: string;
  seodesc?: string;
  seorobots?: string;
}

const {
  title = "ProcessWire Recipes",
  seotitle,
  seodesc = "ProcessWire Recipes - collection of code snippets, demos, playground examples.",
  seorobots = "index,follow",
} = Astro.props;

const domain =  new URL("/", Astro.url);
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const socialImageURL = new URL("/processwire-recipes-ogimage.png", Astro.url);
const faviconURL = new URL("/favicon.png", Astro.url);
const sitemapURL = new URL("/sitemap-index.xml", Astro.url);
const recipeRSS = new URL("/recipes.xml", Astro.url);
//
const currentPath = Astro.url.pathname;
const isHomePage = currentPath === '/' || currentPath === '';
const isRecipesPage = currentPath === '/recipes/' // || currentPath.startsWith('/recipes/');
const showComponents = isHomePage || isRecipesPage;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{seotitle ? seotitle : title}</title>
    <meta name="description" content={seodesc} />
    <meta name="robots" content={seorobots} />
    <link rel="canonical" href={canonicalURL} />
    <meta property="og:image" content={socialImageURL} />
    <!--  -->
    <link rel="icon" type="image/png" href={faviconURL} />
    <link rel="sitemap" href={sitemapURL} />
    <link rel="alternate" type="application/rss+xml" title="processwire.recipes" href={recipeRSS}/>
    <!-- OG -->
    <meta property="og:title" content={seotitle ? seotitle : title} />
    {seodesc &&  <meta property="og:description" content={seodesc} />}
    <meta property="og:image" content={socialImageURL} />
    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta property="twitter:domain" content={domain} />
    <meta property="twitter:url" content={canonicalURL} />
    <meta name="twitter:title" content={seotitle ? seotitle : title} />
    {seodesc && <meta name="twitter:description" content={seodesc} />}
    <meta name="twitter:image" content={socialImageURL} />
    <!--  -->
    <ClientRouter />
    <Tracking />
    <style is:global>
      [x-cloak] { display: none !important; }
    </style>
  </head>

  <body x-data="{ offCanvasOpen: false, scrolled: false }" x-on:scroll.window="scrolled = (window.pageYOffset > 200) ? true : false" :class="offCanvasOpen ? 'overflow-hidden' : ''">
    <Header />
    <main>
      <slot />
    </main>
    {showComponents &&
    <TagCloud />
    <Authors />
    }
    <Footer />
    <!-- <OffCanvas /> -->
  </body>
</html>
