---
import FormattedDate from "./FormattedDate.astro";
import Tag from "./Tag.astro";

interface Props {
  slug: string;
  title: string;
  date: Date;
  authors: string[];
  tags: string[];
}

const { slug, title, date, authors, tags } = Astro.props;
---

<div
  class="border border-gray-100 bg-white p-6 md:p-8 rounded shadow"
  transition:name={slug}
>
  <a href={`/recipes/${slug}/`} class="text-lg block">
    <span class="font-bold">{title}</span>
  </a>
  <ul class="text-gray-500 text-sm tabular-nums leading-normal">
    <li>
      Added/Updated:
      <span class="font-semibold">
        <FormattedDate date={date} />
      </span>
    </li>
    <li>
      Authors:
      <span class="font-semibold">
        {authors.join(", ")}
      </span>
    </li>
  </ul>

  <div class="mt-2 md:mt-4 flex gap-1 md:gap-2 flex-wrap">
    {tags.map((tag) => <Tag tag={tag} />)}
  </div>
</div>
