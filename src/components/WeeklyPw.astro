---
import { getCollection } from "astro:content";
import FormattedDate from "./FormattedDate.astro";

const allItems = await getCollection("weeklypw");
const items = allItems.slice(0, 5);
---

<div class="mx-auto my-24 max-w-2xl">
  <div class="">
    <ul class="flex flex-col gap-4">
      {
        items.map((item) => (
          <li class="border border-gray-100 bg-white p-4 rounded shadow group">
            <a
              href={item.data.link}
              class="block  text-blue-700"
              rel="bookmark"
              target="_blank"
              title={item.data.title}
            >
              <div class="line-clamp-1 font-medium group-hover:underline">
                {item.data.title}
              </div>
              <div class="line-clamp-1 text-sm text-green-700 cursor-pointer ">
                {item.data.link}
              </div>
              <div class="line-clamp-2 text-gray-600 text-sm mt-2">
                {item.data.date && <FormattedDate date={item.data.date} />}
                {item.data.date && item.data.description && " – "}
                {item.data.description && <Fragment set:html={item.data.description} />}
              </div>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</div>
