---
interface Props {
  heading?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
  headline: string;
  text?: string;
  meta?: string;
}

const { heading = "h1", headline, text, meta } = Astro.props;

const HeadingTag = heading;
---

<div class="py-6 pb-12 md:py-12 px-6">
  <div class="max-w-4xl mx-auto md:text-center">
    <HeadingTag
      class="text-gray-900 text-2xl md:text-5xl font-bold text-balance"
      set:html={headline}
      transition:name="headline"
    />

    {
      (text || meta) && (
        <div class="mt-4 text-slate-700 text-base md:text-xl text-balance flex flex-wrap justify-center gap-x-3" transition:name="subline">
          {text && <span>{text}</span>}
          {text && meta && <span class="text-gray-400">|</span>}
          {meta && <span class="text-gray-500">{meta}</span>}
        </div>
      )
    }
  </div>
</div>
