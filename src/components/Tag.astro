---
import { normalizeTag } from "@utils/utils";
interface Props {
  tag: string;
}

const { tag } = Astro.props;
const normalizedTag = normalizeTag(tag);
---

<a
  href={`/topic/${normalizedTag}/`}
  class="bg-pwblue text-white h-8 px-2 rounded shadow-inner flex justify-center items-center hover:bg-pwpink"
>
  <div class="text-xs tracking-widest font-semibold uppercase">
    <span class="text-white/60">#</span><span class="">{tag}</span>
  </div>
</a>
