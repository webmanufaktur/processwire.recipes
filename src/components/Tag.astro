---
import { normalizeTag } from "@utils/utils";
interface Props {
  tag: string;
}

const { tag } = Astro.props;
const normalizedTag = normalizeTag(tag);
---

<a
  href={`/topic/${normalizedTag}/`}
  data-class="bg-pwblue text-white h-8 px-2 rounded shadow-inner flex justify-center items-center hover:bg-pwpink"
  class="bg-gray-50 dark:bg-gray-700 dark:text-gray-100 text-gray-800 h-8 px-2 rounded shadow-inner flex justify-center items-center gap-2"
>
  <div class="text-xs tracking-widest font-semibold uppercase">
    <span class="text-gray-700/60">#</span><span class="">{tag}</span>
  </div>
</a>
