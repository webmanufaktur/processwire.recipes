---
import { normalizeTag } from "@utils/utils";
interface Props {
  tag: string;
  count?: number;
}

const { tag, count } = Astro.props;
const normalizedTag = normalizeTag(tag);
---

<a
  href={`/topic/${normalizedTag}/`}
  data-class="bg-pwblue text-white h-8 px-2 rounded shadow-inner flex justify-center items-center hover:bg-pwpink"
  class="bg-pwblue text-white h-8 px-2 rounded shadow-inner flex justify-center items-center gap-2"
>
  <div class="text-xs tracking-widest uppercase">
    <span class="font-semibold">#</span><span class="font-semibold">{tag}</span>
    {count && <span>({count})</span>}
  </div>
</a>
