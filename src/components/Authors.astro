---
import { getCollection } from "astro:content";
const items = await getCollection("recipes");
import { normalizeTag } from "@utils/utils";

// Extract all authors from all posts
const allAuthors = items
  .flatMap((post) => post.data.authors)
  .sort((a, b) => a.localeCompare(b));

// Create a Set to get unique authors, then convert back to array
const authors = [...new Set(allAuthors)];
---

<section class="py-12 px-6 bg-pwblue text-white">
  <div class="max-w-5xl mx-auto">
    <h2 class="text-xl md:text-2xl font-bold">
      These wonderful people made this whole project possible. 👏 👏 👏
    </h2>

    <div>
      <ul class="mt-8 flex flex-wrap gap-2 md:gap-4">
        {
          authors.map((author) => (
            <li>
              <a
                href={`/authors/${normalizeTag(author)}/`}
                class="bg-slate-50 dark:bg-slate-700 dark:text-slate-100 text-slate-800 h-8 px-2 rounded shadow-inner  flex justify-center items-center gap-2"
              >
                <div class="text-lg">👍</div>
                <div class="uppercase tracking-widest font-bold text-xs">
                  {author}
                </div>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>
