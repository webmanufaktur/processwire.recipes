---
import { getCollection } from "astro:content";
import Base from "@layouts/Base.astro";
import Hero from "@components/Hero.astro";
import FormattedDate from "@components/FormattedDate.astro";
import Tag from "@components/Tag.astro";

export async function getStaticPaths() {
  const allRecipes = await getCollection("recipes");

  // Get all unique authors
  const uniqueAuthors = [
    ...new Set(allRecipes.flatMap((recipe) => recipe.data.authors)),
  ];

  // Create a path for each author
  return uniqueAuthors.map((author) => {
    const filteredRecipes = allRecipes.filter((recipe) =>
      recipe.data.authors.includes(author)
    );
    return {
      params: { slug: author.toLocaleLowerCase() },
      props: { recipes: filteredRecipes, author },
    };
  });
}

const { recipes, author } = Astro.props;
---

<Base title={`Recipes by ${author}`}>
  <Hero
    heading="h1"
    headline={`Recipes by <span class="text-pwpink">${author}</span>`}
    text="A collection of recipes created by this author."
  />
  <section class="bg-pw-gradient">
    <ul class="space-y-8 md:space-y-12 max-w-2xl w-full mx-auto px-4">
      {
        recipes.map((recipe) => (
          <li>
            <div class="border border-gray-100 bg-white p-6 md:p-8 rounded shadow">
              <a href={`/recipes/${recipe.slug}/`} class="text-lg block">
                <span class="font-bold">{recipe.data.title}</span>
              </a>
              <ul class="text-gray-500 text-sm tabular-nums leading-normal">
                <li>
                  Added/Updated:
                  <span class="font-semibold">
                    <FormattedDate date={recipe.data.date} />
                  </span>
                </li>
                <li>
                  Authors:
                  <span class="font-semibold">
                    {recipe.data.authors.join(", ")}
                  </span>
                </li>
              </ul>

              <div class="mt-2 md:mt-4 flex gap-1 md:gap-2 flex-wrap">
                {recipe.data.tags.map((tag) => (
                  <Tag tag={tag} />
                ))}
              </div>
            </div>
          </li>
        ))
      }
    </ul>
  </section>
</Base>
