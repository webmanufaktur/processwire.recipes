---
import { getCollection } from "astro:content";
import Base from "@layouts/Base.astro";
import Hero from "@components/Hero.astro";
// import FormattedDate from "@components/FormattedDate.astro";
// import Tag from "@components/Tag.astro";
import { normalizeTag } from "@utils/utils";
import RecipeCard from "@components/RecipeCard.astro";

export async function getStaticPaths() {
  const allRecipes = await getCollection("recipes");

  // Get all unique authors
  const uniqueAuthors = [
    ...new Set(allRecipes.flatMap((recipe) => recipe.data.authors)),
  ];

  // Create a path for each author
  return uniqueAuthors.map((author) => {
    const filteredRecipes = allRecipes.filter((recipe) =>
      recipe.data.authors.includes(author)
    );
    return {
      params: { slug: normalizeTag(author) },
      props: { recipes: filteredRecipes, author },
    };
  });
}

const { recipes, author } = Astro.props;
---

<Base
  title={`${author} | processwire.recipes`}
  seorobots="noindex"
  seodesc={`ProcessWire API snippets by ${author}. Find these and more recipes on the processwire.recipes website.`}
>
  <Hero
    heading="h1"
    headline={`Recipes by <div class="text-pwblue mt-2 uppercase">${author}</div>`}
  />
  <section class="bg-pw-gradient">
    <ul class="space-y-8 md:space-y-12 max-w-2xl w-full mx-auto px-4">
      {
        recipes.map((recipe) => (
          <li>
            <RecipeCard slug={recipe.slug} {...recipe.data} />
          </li>
        ))
      }
    </ul>
  </section>
</Base>
