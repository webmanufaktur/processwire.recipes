---
// layouts, components, ...
import FormattedDate from "@components/FormattedDate.astro";
import Hero from "@components/Hero.astro";
import Tag from "@components/Tag.astro";
import Base from "@layouts/Base.astro";
import { normalizeTag } from "@utils/utils";

// logic
import { type CollectionEntry, getCollection, render } from "astro:content";

export const prerender = true;

export async function getStaticPaths() {
  const items = await getCollection("recipes");

  return items.map((item) => ({
    params: { id: item.id },
    props: item,
  }));
}

type Props = CollectionEntry<"recipes">;

const item = Astro.props;
const { Content } = await render(item);
---

<Base {...item.data}>
  <article>
    <Hero headline={item.data.title} />
    <div class="bg-pw-gradient px-4">
      <div class="max-w-5xl mx-auto">
        <div class="md:grid md:grid-cols-3 md:gap-8">
          <div class="col-span-2">
            <div
              class="bg-white max-w-3xl p-4 md:p-12 border border-gray-100 md:shadow md:rounded mx-auto"
            >
              <div class="prose max-w-none">
                <Content />
              </div>
            </div>
          </div>
          <div class="text-white pt-24 pb-36 px-6">
            <!-- SIDEBAR -->
            <aside class="flex flex-col gap-4">
              <!-- AUTHORS -->
              <div>
                <h4 class="font-bold text-xs uppercase tracking-widest mb-2">
                  Authors
                </h4>
                <ul class="flex flex-wrap gap-2 md:gap-4">
                  {
                    item.data.authors.map((author) => (
                      <li>
                        <a
                          href={`/authors/${normalizeTag(author)}/`}
                          class="bg-slate-50 dark:bg-slate-700 dark:text-slate-100 text-slate-800 h-8 px-2 rounded shadow-inner  flex justify-center items-center gap-2"
                        >
                          <div class="text-lg">👍</div>
                          <div class="uppercase tracking-widest font-bold text-xs">
                            {author}
                          </div>
                        </a>
                      </li>
                    ))
                  }
                </ul>
              </div>
              <!-- TAGS -->
              <div>
                <h4 class="font-bold text-xs uppercase tracking-widest mb-2">
                  Tags
                </h4>
                <ul class="flex flex-wrap gap-2 md:gap-4">
                  {
                    item.data.tags.map((tag) => (
                      <li>
                        <Tag tag={tag} />
                      </li>
                    ))
                  }
                </ul>
              </div>
              <!-- VERSION -->
              <div>
                <h4 class="font-bold text-xs uppercase tracking-widest mb-2">
                  Version
                </h4>
                <div class="tabular-nums">{item.data.version}</div>
              </div>
              <!-- DATE -->
              <div>
                <h4 class="font-bold text-xs uppercase tracking-widest mb-2">
                  Date
                </h4>
                <FormattedDate date={item.data.date} />
              </div>
              <!-- PROCESSWIRE
              <div>
                processwire: {item.data.processwire}
              </div>-->
              <!-- DEPENDENCIES
              <div>dependencies: {item.data.dependencies}</div>-->
            </aside>
          </div>
        </div>
      </div>
    </div>
  </article>
</Base>
