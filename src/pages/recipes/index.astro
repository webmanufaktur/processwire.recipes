---
import Hero from "@components/Hero.astro";
import RecipeCard from "@components/RecipeCard.astro";
import Base from "@layouts/Base.astro";

import { getCollection } from "astro:content";
const allRecipes = await getCollection("recipes");
// sort all recipes by date - new to old
const recipes = allRecipes.sort(
  (a, b) => +new Date(b.data.date) - +new Date(a.data.date)
);
---

<Base title="ProcessWire Recipes" seorobots="noindex">
  <article>
    <Hero
      heading="h1"
      headline="ProcessWire Recipes"
      text="A collection of ProcessWire API snippets to solve common tasks, provide full solutions, and some little helpers that make work with the API easier."
    />

    <section class="bg-pw-gradient">
      <ul class="space-y-8 md:space-y-12 max-w-2xl w-full mx-auto px-4">
        {
          recipes.map((recipe) => (
            <li>
              <RecipeCard slug={recipe.id} {...recipe.data} />
            </li>
          ))
        }
      </ul>
    </section>
  </article>
</Base>
