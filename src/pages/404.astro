---
import Button from "@components/Button.astro";
import FormattedDate from "@components/FormattedDate.astro";
import Hero from "@components/Hero.astro";
import Tag from "@components/Tag.astro";
import Base from "@layouts/Base.astro";

import { getCollection } from "astro:content";
const allRecipes = await getCollection("recipes");
// sort all recipes by date - new to old
const recipes = allRecipes.sort(
  (a, b) => +new Date(b.data.date) - +new Date(a.data.date)
);
// limit recipes to 4
const limitedRecipes = recipes.slice(0, 4);
---

<Base title="ProcessWire Recipes" robots="noindex">
  <article>
    <Hero
      heading="h1"
      headline="ProcessWire Recipes"
      text="A collection of ProcessWire API snippets to solve common tasks, provide full solutions, and some little helpers that make work with the API easier."
    />

    <section class="bg-pw-gradient">
      <ul class="space-y-8 md:space-y-12 max-w-2xl w-full mx-auto px-4">
        {
          limitedRecipes.map((recipe) => (
            <li>
              <div class="border border-gray-100 bg-white p-6 md:p-8 rounded shadow">
                <a href={`/recipes/${recipe.slug}/`} class="text-lg block">
                  <span class="font-bold">{recipe.data.title}</span>
                </a>
                <ul class="text-gray-500 text-sm tabular-nums leading-normal">
                  <li>
                    Added/Updated:
                    <span class="font-semibold">
                      <FormattedDate date={recipe.data.date} />
                    </span>
                  </li>
                  <li>
                    Authors:
                    <span class="font-semibold">
                      {(() => {
                        const stringAuthors = recipe.data.authors.map(String);
                        return stringAuthors.join(", ");
                      })()}
                    </span>
                  </li>
                </ul>

                <div class="mt-2 md:mt-4 flex gap-1 md:gap-2 flex-wrap">
                  {recipe.data.tags.map((tag) => (
                    <Tag tag={tag} />
                  ))}
                </div>
              </div>
            </li>
          ))
        }
      </ul>
    </section>

    <div class="table mx-auto mt-8">
      <Button
        label="See all ProcessWire Recipes"
        url="/recipes/"
        size="large"
        style="outline"
      />
    </div>
  </article>
</Base>
