---
import Base from "@layouts/Base.astro";
import Hero from "@components/Hero.astro";
import Button from "@components/Button.astro";
import RecipeCard from "@components/RecipeCard.astro";

import { getCollection } from "astro:content";
const allRecipes = await getCollection("recipes");
// sort all recipes by date - new to old
const recipes = allRecipes.sort(
  (a, b) => +new Date(b.data.date) - +new Date(a.data.date)
);
// limit recipes to 4
const limitedRecipes = recipes.slice(0, 4);
---

<Base title="ProcessWire Recipes" seorobots="noindex">
  <article>
    <Hero
      heading="h1"
      headline="ProcessWire Recipes"
      text="A collection of ProcessWire API snippets to solve common tasks, provide full solutions, and some little helpers that make work with the API easier."
    />

    <section class="bg-pw-gradient">
      <ul class="space-y-8 md:space-y-12 max-w-2xl w-full mx-auto px-4">
        {
          limitedRecipes.map((recipe) => (
            <li>
              <RecipeCard slug={recipe.slug} {...recipe.data} />
            </li>
          ))
        }
      </ul>
    </section>

    <div class="table mx-auto mt-8">
      <Button
        label="See all ProcessWire Recipes"
        url="/recipes/"
        size="large"
        style="outline"
      />
    </div>
  </article>
</Base>
