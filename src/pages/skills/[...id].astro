---
import type { GetStaticPaths } from "astro";
import Hero from "@components/Hero.astro";
import Base from "@layouts/Base.astro";
import { type CollectionEntry, getCollection, render } from "astro:content";

export const prerender = true;

export const getStaticPaths = (async () => {
  const items = await getCollection("skills");

  return items.map((item) => {
    // Remove trailing "/skill" from ID to create cleaner URLs
    // e.g., "processwire/api/skill" becomes "processwire/api"
    const cleanId = item.id.replace(/\/skill$/, "");
    return {
      params: { id: cleanId },
      props: item,
    };
  });
}) satisfies GetStaticPaths;

type Props = CollectionEntry<"skills">;

const item = Astro.props;
const { Content } = await render(item);
---

<Base title={`${item.data.name} | ProcessWire Skills`}>
  <article>
    <Hero headline={item.data.name} />
    <div class="bg-pw-gradient px-4">
      <div class="max-w-5xl mx-auto">
        <div class="py-8">
          <div
            class="bg-white max-w-3xl p-4 md:p-12 border border-gray-100 md:shadow md:rounded mx-auto"
            transition:name={item.id}
          >
            <div class="prose max-w-none">
              <Content />
            </div>
          </div>
        </div>
      </div>
    </div>
  </article>
</Base>
