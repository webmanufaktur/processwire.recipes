---
import { getCollection } from "astro:content";
import Base from "@layouts/Base.astro";
import Hero from "@components/Hero.astro";
import FormattedDate from "@components/FormattedDate.astro";
import Tag from "@components/Tag.astro";
import { normalizeTag } from "@utils/utils";

export async function getStaticPaths() {
  const allRecipes = await getCollection("recipes");

  // Get all unique tags
  const uniqueTags = [
    ...new Set(allRecipes.flatMap((recipe) => recipe.data.tags)),
  ];

  // Create a path for each tag
  return uniqueTags.map((tag) => {
    const filteredRecipes = allRecipes.filter((recipe) =>
      recipe.data.tags.includes(tag)
    );
    return {
      params: { slug: normalizeTag(tag) },
      props: { recipes: filteredRecipes, tag },
    };
  });
}

const { recipes, tag } = Astro.props;
---

<Base
  title={`Recipes tagged with ${tag} | processwire.recipes`}
  desc={`ProcessWire API snippets tagged with ${tag}. Find these and more recipes on the processwire.recipes website.`}
>
  <Hero
    heading="h1"
    headline={`Recipes tagged with <div class="text-pwpink mt-2 uppercase">${tag}</div>`}
  />
  <section class="bg-pw-gradient">
    <ul class="space-y-8 md:space-y-12 max-w-2xl w-full mx-auto px-4">
      {
        recipes.map((recipe) => (
          <li>
            <div class="border border-gray-100 bg-white p-6 md:p-8 rounded shadow">
              <a href={`/recipes/${recipe.slug}/`} class="text-lg block">
                <span class="font-bold">{recipe.data.title}</span>
              </a>
              <ul class="text-gray-500 text-sm tabular-nums leading-normal">
                <li>
                  Added/Updated:
                  <span class="font-semibold">
                    <FormattedDate date={recipe.data.date} />
                  </span>
                </li>
                <li>
                  Authors:
                  <span class="font-semibold">
                    {(() => {
                      const stringAuthors = recipe.data.authors.map(String);
                      return stringAuthors.join(", ");
                    })()}
                  </span>
                </li>
              </ul>

              <div class="mt-2 md:mt-4 flex gap-1 md:gap-2 flex-wrap">
                {recipe.data.tags.map((tag) => (
                  <Tag tag={tag} />
                ))}
              </div>
            </div>
          </li>
        ))
      }
    </ul>
  </section>
</Base>
