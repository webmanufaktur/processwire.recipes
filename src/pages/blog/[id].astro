---
import Hero from "@components/Hero.astro";
import Base from "@layouts/Base.astro";

import { type CollectionEntry, getCollection, render } from "astro:content";

export const prerender = true;

export async function getStaticPaths() {
  const items = await getCollection("posts");

  return items.map((item) => ({
    params: { id: item.id },
    props: item,
  }));
}

type Props = CollectionEntry<"posts">;

const item = Astro.props;
const { Content } = await render(item);
const formattedDate = new Date(item.data.date).toLocaleDateString("en-US", {
  year: "numeric",
  month: "long",
  day: "numeric",
});
const authorMeta = item.data.authors ? item.data.authors.join(", ") : undefined;
---

<Base title={item.data.title}>
  <article>
    <Hero
      headline={item.data.title}
      text={formattedDate}
      meta={authorMeta}
      category={item.data.category}
    />
    <div class="bg-pw-gradient px-4">
      <div class="max-w-3xl mx-auto">
        <div
          class="bg-white p-6 md:p-12 border border-gray-100 md:shadow md:rounded"
        >
          <div class="prose max-w-none prose-a:text-pwpink prose-a:font-semibold">
            <Content />
          </div>
        </div>
      </div>
    </div>
  </article>
</Base>
